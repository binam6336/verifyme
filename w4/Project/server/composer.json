{
    "require": {
        "monolog/monolog": "^3.10",
        "guzzlehttp/guzzle": "*",
        "firebase/php-jwt": "*",
        "ezyang/htmlpurifier": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "*",
        "phpstan/phpstan": "^2.2"
    },
    "scripts": {
        "test": "php vendor/phpunit/phpunit/phpunit",
        "phpstan": "php vendor/bin/phpstan analyse Src",
        "phpstanl5": "php vendor/bin/phpstan analyse Src --level=5",
        "phpstanl9": "php vendor/bin/phpstan analyse Src --level=9"
    },
    "autoload": {
        "psr-4": {
            "Src\\": "Src/"
        }
    }
}
